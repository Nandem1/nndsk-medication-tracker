APP_ENV=development
HTTP_ADDR=127.0.0.1:8080
POSTGRES_DB=medication_tracker
POSTGRES_USER=medication_dev
POSTGRES_PASSWORD=local_only_change_me
POSTGRES_PORT=55433
DATABASE_URL=postgres://medication_dev:local_only_change_me@127.0.0.1:55433/medication_tracker?sslmode=disable
# Optional private CA PEM, injected by the deployment environment; requires sslmode=verify-full.
# DATABASE_CA_PEM=
FIREBASE_PROJECT_ID=demo-medication-local
# F8 API requires ADC to check disabled/deleted accounts and revoked tokens.
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/outside-repository/service-account.json

# F6 keeps remote delivery opt-in. See docs/runbooks/f6-recovery.md.
WORKER_PUSH_MODE=disabled
# METRICS_ADDR defaults to 127.0.0.1:9090 (API), 127.0.0.1:9091 (worker).
# PUSH_FCM_PROJECT_ID=synthetic-staging-project
# PUSH_APNS_KEY_FILE=/absolute/path/outside-repository/signing-key.p8
# PUSH_APNS_KEY_ID=configure-me
# PUSH_APNS_TEAM_ID=configure-me
# PUSH_APNS_TOPIC=configure-me
# PUSH_APNS_SANDBOX=true
# BACKUP_KEY_FILE=/absolute/path/outside-repository/backup-key
# BACKUP_ARCHIVE=/absolute/path/outside-repository/backup.enc
