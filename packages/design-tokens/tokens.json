{
  "name": "graphite",
  "version": 1,
  "description": "Fuente de verdad de los valores visuales compartidos. Los adaptadores se generan con build.mjs; no se editan a mano.",
  "color": {
    "bg": { "light": "#F7F7F8", "dark": "#0F0F11", "role": "Fondo de pantalla" },
    "surface": { "light": "#FFFFFF", "dark": "#17171A", "role": "Tarjetas y paneles" },
    "surfaceRaised": { "light": "#F0F0F2", "dark": "#1E1E22", "role": "Superficie secundaria, iconos de medicamento, chips neutros" },
    "border": { "light": "#E4E4E7", "dark": "#26262B", "role": "Divisores decorativos" },
    "borderStrong": { "light": "#7C7C85", "dark": "#7C7C85", "role": "Bordes de controles; no decorativos" },
    "text": { "light": "#17171A", "dark": "#EDEDF0", "role": "Texto principal" },
    "textMuted": { "light": "#5E5E66", "dark": "#9A9AA3", "role": "Texto secundario" },
    "action": { "light": "#17171A", "dark": "#EDEDF0", "role": "Fondo de la acción principal (tinta)" },
    "onAction": { "light": "#FFFFFF", "dark": "#0F0F11", "role": "Texto sobre action" },
    "accent": { "light": "#4338CA", "dark": "#A5A1FF", "role": "Enlaces, foco, selección y dato destacado" },
    "accentFill": { "light": "#4338CA", "dark": "#5B54E8", "role": "Relleno de selección" },
    "onAccent": { "light": "#FFFFFF", "dark": "#FFFFFF", "role": "Texto sobre accentFill" },
    "scheduledFg": { "light": "#47474E", "dark": "#C4C4CC", "role": "Programada" },
    "scheduledBg": { "light": "#F0F0F2", "dark": "#26262B", "role": "Programada" },
    "unconfirmedFg": { "light": "#8A4B00", "dark": "#FFB95C", "role": "Sin confirmar: derivado del reloj, no es omisión" },
    "unconfirmedBg": { "light": "#FFF1D6", "dark": "#33240E", "role": "Sin confirmar" },
    "takenFg": { "light": "#17663A", "dark": "#6EDB98", "role": "Declarada tomada" },
    "takenBg": { "light": "#E3F4EA", "dark": "#10301D", "role": "Declarada tomada" },
    "takenLateFg": { "light": "#0F6874", "dark": "#5FD3E0", "role": "Declarada tomada tarde; no penalizada" },
    "takenLateBg": { "light": "#E0F3F5", "dark": "#0D2A2E", "role": "Declarada tomada tarde" },
    "skippedFg": { "light": "#47474E", "dark": "#C4C4CC", "role": "Declarada omitida; neutra a propósito" },
    "skippedBg": { "light": "#ECECEF", "dark": "#26262B", "role": "Declarada omitida" },
    "syncFg": { "light": "#3730A3", "dark": "#C7C4FF", "role": "Guardada localmente, falta enviar" },
    "syncBg": { "light": "#EEEDFE", "dark": "#24224A", "role": "Guardada localmente, falta enviar" },
    "dangerFg": { "light": "#B42318", "dark": "#FF8A80", "role": "Conflicto o rechazo que exige decidir" },
    "dangerBg": { "light": "#FDECEA", "dark": "#3A1512", "role": "Conflicto o rechazo" },
    "chartTaken": { "light": "#2E9E5B", "dark": "#4CC37A", "role": "Serie tomada" },
    "chartTakenLate": { "light": "#1C9AAA", "dark": "#8FE3EC", "role": "Serie tomada tarde" },
    "chartSkipped": { "light": "#8E8E98", "dark": "#5E5E66", "role": "Serie omitida" },
    "chartUnconfirmed": { "light": "#B86E00", "dark": "#F0A23A", "role": "Serie sin confirmar; dibujar además con trama" }
  },
  "contrast": {
    "text": [
      ["text", "bg"], ["text", "surface"], ["text", "surfaceRaised"],
      ["textMuted", "bg"], ["textMuted", "surface"], ["textMuted", "surfaceRaised"],
      ["onAction", "action"], ["onAccent", "accentFill"],
      ["accent", "bg"], ["accent", "surface"],
      ["scheduledFg", "scheduledBg"], ["scheduledFg", "surface"],
      ["unconfirmedFg", "unconfirmedBg"], ["unconfirmedFg", "surface"], ["unconfirmedFg", "bg"],
      ["takenFg", "takenBg"], ["takenFg", "surface"], ["takenFg", "bg"],
      ["takenLateFg", "takenLateBg"], ["takenLateFg", "surface"], ["takenLateFg", "bg"],
      ["skippedFg", "skippedBg"], ["skippedFg", "surface"],
      ["syncFg", "syncBg"], ["syncFg", "surface"],
      ["dangerFg", "dangerBg"], ["dangerFg", "surface"], ["dangerFg", "bg"]
    ],
    "nonText": [
      ["borderStrong", "surface"], ["borderStrong", "bg"], ["accent", "surface"], ["action", "surface"],
      ["chartTaken", "surface"], ["chartTakenLate", "surface"], ["chartUnconfirmed", "surface"]
    ]
  },
  "space": { "xxs": 2, "xs": 4, "sm": 8, "md": 12, "lg": 16, "xl": 24, "xxl": 32, "xxxl": 48 },
  "radius": { "sm": 8, "md": 12, "lg": 16, "xl": 24, "pill": 999 },
  "size": {
    "minTouchIos": 44,
    "minTouchAndroid": 48,
    "patientAction": 64,
    "patientIcon": 64,
    "borderWidth": 2
  },
  "font": {
    "web": {
      "sans": "Geist, ui-sans-serif, system-ui, -apple-system, \"Segoe UI\", sans-serif",
      "mono": "\"Geist Mono\", ui-monospace, SFMono-Regular, Menlo, monospace"
    },
    "native": "system"
  },
  "type": {
    "patientDisplay": { "size": 34, "lineHeight": 40, "weight": 800, "ios": "largeTitle", "role": "Hora de la siguiente toma" },
    "patientTitle": { "size": 26, "lineHeight": 32, "weight": 700, "ios": "title", "role": "Nombre del medicamento" },
    "patientBody": { "size": 20, "lineHeight": 28, "weight": 400, "ios": "title3", "role": "Cantidad e instrucciones" },
    "patientLabel": { "size": 17, "lineHeight": 22, "weight": 600, "ios": "headline", "role": "Etiquetas, estados y el mínimo de lectura" },
    "caregiverMetric": { "size": 40, "lineHeight": 40, "weight": 500, "ios": "largeTitle", "mono": true, "role": "Cifra de un KPI" },
    "caregiverHeading": { "size": 22, "lineHeight": 28, "weight": 600, "ios": "title2", "role": "Encabezado de sección" },
    "caregiverBody": { "size": 15, "lineHeight": 22, "weight": 400, "ios": "subheadline", "role": "Texto denso del portal" },
    "caregiverCaption": { "size": 13, "lineHeight": 18, "weight": 400, "ios": "footnote", "role": "Denominadores, períodos y notas" }
  }
}
